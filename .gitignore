# impeccable ships a 12MB per-platform native binary (x2, one per harness).
# Do not commit it: it is downloaded on first run and only works on the arch
# it was built for.
**/skills/impeccable/scripts/bin/
.impeccable/config.local.json

# Higgsfield: image/video generation tooling, nothing to do with the OPA app.
# The MCP connector is per-machine and authenticates interactively; the skills
# are a 1.2MB third-party bundle. Neither belongs in this repo's history.
.mcp.json
.agents/

# The taste-skill bundles are SYMLINKS into .agents/, which is ignored above —
# committing them would push dangling links. They are advisory third-party
# packs that OPA never invokes (CLAUDE.md's antd-only rules win every conflict),
# so they stay out of the product's history. .claude/skills/impeccable is a
# real directory and stays tracked.
.claude/skills/higgsfield-*
.claude/skills/brandkit
.claude/skills/design-taste-frontend
.claude/skills/design-taste-frontend-v1
.claude/skills/full-output-enforcement
.claude/skills/gpt-taste
.claude/skills/high-end-visual-design
.claude/skills/image-to-code
.claude/skills/imagegen-frontend-mobile
.claude/skills/imagegen-frontend-web
.claude/skills/industrial-brutalist-ui
.claude/skills/minimalist-ui
.claude/skills/redesign-existing-projects
.claude/skills/stitch-design-taste
